rules_version = '2';

// These rules apply to clients using the Firebase SDK (the admin panel in src/).
// The Cloud Functions in functions/ authenticate with a service account and use
// the Admin SDK, which bypasses rules entirely — so locking things down here
// does not affect the API endpoints at all.
//
// "Signed in" does not mean "trusted": Firebase Auth hands out a token to
// whoever asks, whatever the site itself offers. Both halves of the old
// catch-all were written when the only two accounts were the two admins, and
// both were wrong — reads exposed every collection to every visitor holding a
// token, and writes were allowed on anything not named Meetstandaard*.
//
// So: nothing is writable by any client, and only an admin reads anything.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Every write goes through the Admin SDK — the seed scripts for published
    // standaarden, and the feedback endpoints in functions/ for everything a
    // visitor submits. There is deliberately no client write path left, so a
    // collection added later is protected before it exists rather than after
    // someone remembers this file (see docs/pitfalls.md#deploy-firestore-rules-full-replace).
    match /{collection}/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
